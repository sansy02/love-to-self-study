# 环境变量示例：本地复制为 .env，或在 Render 的 Environment 页面逐条填写。不要把真实的 Key 提交到 GitHub。

# ---------- 安全（必填） ----------
# 至少 32 位随机字符，可以用：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 可选：单独用于加密用户 API Key 的密钥；不填就用 JWT_SECRET 派生。注意：换掉以后，已保存的用户 Key 需要重新填写。
ENCRYPTION_KEY=

# ---------- 登录模式 ----------
# anonymous（默认，账号密码下线，打开就能用） / account（只用邮箱登录） / both
AUTH_MODE=anonymous

# ---------- 免费模型（至少填一个） ----------
# 主力：Google AI Studio 申请 https://aistudio.google.com/apikey  （免费档内容会被 Google 用于改进产品）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 3.x 系列不能关闭思考，low 更快
GEMINI_REASONING_EFFORT=low

# 备用：智谱开放平台 https://open.bigmodel.cn  （免费模型，免费档只有 1 个并发）
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash
# 可选：给图片页用的智谱视觉模型，例如 glm-4.6v-flash
GLM_VISION_MODEL=

# 旧版站长 Key（DeepSeek），不需要可以留空
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ---------- 额度 ----------
# 每人每天可用的「新生成」次数（已缓存的讲解不计次；自带 Key 不限）
FREE_DAILY_LIMIT=60
FREE_DAILY_LIMIT_PER_IP=200

# ---------- 其他 ----------
DATABASE_URL=sqlite:///./aixue.db
ALLOWED_ORIGINS=http://localhost:5173,https://love-to-self-study.vercel.app
MAX_FILE_MB=20
MAX_PAGES=150
